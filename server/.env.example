# Copy to .env and fill in. Port 5434 because 5432/5433 are already taken on this machine.
DATABASE_URL="postgresql://safeway:safeway@localhost:5434/safeway?schema=public"
PORT=8787
JWT_SECRET="<any-long-random-string>"
WEB_ORIGIN="http://localhost:5174"

# Port 6380 because 6379 is already taken on this machine. Tests use database 1.
REDIS_URL="redis://localhost:6380"

# Review note check (server/ai/check_review.py). Any OpenAI-compatible endpoint.
# Leave the key unset to turn the check off.
REVIEW_CHECK_BASE_URL="http://127.0.0.1:8317/v1"
REVIEW_CHECK_MODEL="claude-sonnet-5"
REVIEW_CHECK_API_KEY=""
